{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/preload/*.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    // api.ts imports domain.ts with the extension, for the same reason src/main/db.ts imports
    // ./log.ts: scripts/check-api.mjs runs these files through bare node, and node's ESM resolver
    // does not guess an extension. Vite rewrites it at build time; this lets tsc accept it.
    "allowImportingTsExtensions": true
  }
}
